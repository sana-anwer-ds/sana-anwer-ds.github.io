<svg class="ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
<svg class="ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
</button>
<span class="sepv"></span>
<a class="ib nav-ico" href="#linkedin" aria-label="LinkedIn profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></a>
<a class="ib nav-ico" href="#github" aria-label="GitHub profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg></a>
<a class="ib nav-ico" href="#email" aria-label="Email Sana"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></a>
</div>
</header>
</div>

<main id="top">

<!-- 2 + 3. HERO -->
<section class="hero">
<div class="wrap">
<div class="hero-grid">
<div>
<span class="pill"><span class="dot" aria-hidden="true"></span>Data Scientist, open to new projects</span>
<h1 class="h1">Data is power. Read it <em>without bias</em>.</h1>
<p class="lede">I study data in health, law and public policy to find out what is true, then help people use it to make change that holds up.</p>
<div class="cta-row">
<a class="btn btn-p" href="#contact">Book a call</a>
<a class="btn btn-g" href="#work">See case studies</a>
</div>
<p class="hero-note">Placeholder site for design review. All names, figures and results are synthetic.</p>
</div>

<div class="graph-wrap">
<div class="graph">
<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
<!-- small nodes to large nodes -->
<line class="ln-s" x1="12" y1="14" x2="30" y2="22"/>
<line class="ln-s" x1="48" y1="8" x2="30" y2="22"/>
<line class="ln-s" x1="48" y1="8" x2="72" y2="30"/>
<line class="ln-s" x1="88" y1="14" x2="72" y2="30"/>
<line class="ln-s" x1="8" y1="44" x2="30" y2="22"/>
<line class="ln-s" x1="8" y1="44" x2="24" y2="68"/>
<line class="ln-s" x1="92" y1="52" x2="72" y2="30"/>
<line class="ln-s" x1="92" y1="52" x2="76" y2="78"/>
<line class="ln-s" x1="40" y1="38" x2="30" y2="22"/>
<line class="ln-s" x1="40" y1="38" x2="52" y2="52"/>
<line class="ln-s" x1="62" y1="70" x2="52" y2="52"/>
<line class="ln-s" x1="62" y1="70" x2="76" y2="78"/>
<line class="ln-s" x1="36" y1="58" x2="52" y2="52"/>
<line class="ln-s" x1="36" y1="58" x2="24" y2="68"/>
<line class="ln-s" x1="40" y1="88" x2="24" y2="68"/>
<line class="ln-s" x1="40" y1="88" x2="60" y2="92"/>
<line class="ln-s" x1="60" y1="92" x2="76" y2="78"/>
<line class="ln-s" x1="12" y1="88" x2="24" y2="68"/>
<line class="ln-s" x1="92" y1="90" x2="76" y2="78"/>
<!-- large node links -->
<line class="ln" x1="30" y1="22" x2="72" y2="30"/>
<line class="ln" x1="30" y1="22" x2="52" y2="52"/>
<line class="ln" x1="72" y1="30" x2="52" y2="52"/>
<line class="ln" x1="52" y1="52" x2="24" y2="68"/>
<line class="ln" x1="52" y1="52" x2="76" y2="78"/>
<line class="ln" x1="24" y1="68" x2="76" y2="78"/>
<circle class="sn" cx="12" cy="14" r="1.1"/><circle class="sn" cx="48" cy="8" r="1.1"/><circle class="sn" cx="88" cy="14" r="1.1"/>
<circle class="sn" cx="8" cy="44" r="1.1"/><circle class="sn" cx="92" cy="52" r="1.1"/><circle class="sn" cx="40" cy="38" r="1.1"/>
<circle class="sn" cx="62" cy="70" r="1.1"/><circle class="sn" cx="40" cy="88" r="1.1"/><circle class="sn" cx="60" cy="92" r="1.1"/>
<circle class="sn" cx="12" cy="88" r="1.1"/><circle class="sn" cx="92" cy="90" r="1.1"/><circle class="sn" cx="36" cy="58" r="1.1"/>
</svg>
<a class="node" href="#services" style="left:30%;top:22%"><span class="orb"><span aria-hidden="true">σ</span></span><span class="lbl">Health Forecasting</span><span class="sub">σ variance</span></a>
<a class="node" href="#services" style="left:72%;top:30%"><span class="orb"><span aria-hidden="true">Δ</span></span><span class="lbl">Policy Evaluation</span><span class="sub">Δ change</span></a>
<a class="node" href="#work" style="left:52%;top:52%"><span class="orb"><span aria-hidden="true">μ</span></span><span class="lbl">Case Studies</span><span class="sub">μ the mean case</span></a>
<a class="node" href="#about" style="left:24%;top:68%"><span class="orb"><span aria-hidden="true">θ</span></span><span class="lbl">About</span><span class="sub">θ parameters</span></a>
<a class="node" href="#contact" style="left:76%;top:78%"><span class="orb"><span aria-hidden="true">λ</span></span><span class="lbl">Contact</span><span class="sub">λ rate</span></a>
</div>
<nav aria-label="Quick links">
<ul class="linklist">
<li class="eyebrow">Quick links</li>
<li><a href="#services"><span class="gl" aria-hidden="true">σ</span>Health Forecasting</a></li>
<li><a href="#services"><span class="gl" aria-hidden="true">Δ</span>Policy Evaluation</a></li>
<li><a href="#work"><span class="gl" aria-hidden="true">μ</span>Case Studies</a></li>
<li><a href="#about"><span class="gl" aria-hidden="true">θ</span>About</a></li>
<li><a href="#contact"><span class="gl" aria-hidden="true">λ</span>Contact</a></li>
</ul>
</nav>
</div>
</div>

<!-- services strip -->
<div class="svc" id="services">
<div>
<span class="eyebrow">01 · Health data</span>
<h3>Trends with honest uncertainty</h3>
<p>Disease, capacity and access forecasts that show the range, not just the line.</p>
</div>
<div>
<span class="eyebrow">02 · Policy evaluation</span>
<h3>Did the change work?</h3>
<p>Comparison-group methods that separate a policy's effect from what was already happening.</p>
</div>
<div>
<span class="eyebrow">03 · Law and justice data</span>
<h3>Bias checks that show their work</h3>
<p>Audits of scores and decisions for unequal error rates, with every assumption written down.</p>
</div>
</div>
</section>

<!-- 4. FEATURED CASE STUDY -->
<section class="sec" id="featured">
<div class="wrap">
<div class="card feat">
<div class="dash" role="img" aria-label="Synthetic line chart of weekly missed appointments: the actual line drops below a dashed expected line, with an uncertainty band, after a vertical program start marker">
<div class="dash-h">
<span class="dash-t">Weekly missed appointments, before and after a program</span>
<span class="chip chip-a">Synthetic data</span>
</div>
<svg viewBox="0 0 600 240" width="100%" style="display:block;height:auto" aria-hidden="true" preserveAspectRatio="none">
<line class="c-grid" x1="0" y1="40" x2="600" y2="40"/><line class="c-grid" x1="0" y1="100" x2="600" y2="100"/><line class="c-grid" x1="0" y1="160" x2="600" y2="160"/><line class="c-grid" x1="0" y1="220" x2="600" y2="220"/>
<polygon class="c-band" points="300,102 350,86 400,76 450,76 500,68 550,66 600,66 600,134 550,130 500,126 450,128 400,120 350,116"/>
<polyline class="c-fc" points="300,102 350,100 400,98 450,102 500,96 550,98 600,100"/>
<polyline class="c-act" points="0,110 50,98 100,108 150,96 200,104 250,100 300,102 350,120 400,138 450,150 500,158 550,160 600,166"/>
<line class="c-today" x1="300" y1="10" x2="300" y2="214"/>
<polygon class="c-bob" points="300,214 294,220 300,226 306,220"/>
</svg>
<div class="xl"><span>Before</span><span>Program starts</span><span>After</span></div>
<div class="legend">
<span><i class="sw"></i>Actual</span>
<span><i class="sw sw-a"></i>Expected without the program</span>
<span><i class="sw sw-b"></i><span class="gl" aria-hidden="true">σ</span> uncertainty band</span>
</div>
</div>
<div>
<span class="eyebrow">Featured case study · flagship</span>
<h2>Did the outreach program really reduce missed visits?</h2>
<p>[Clinic network name], a synthetic example. I compared the program with similar clinics, then stress tested the estimate for bias before reporting one number. Figures are placeholders.</p>
<div class="stats">
<div>
<span class="fig fig-a">-5.6<small>pts</small></span>
<span class="sl"><span class="gl" aria-hidden="true">Δ</span>Change in missed visits, interval -9.1 to -2.0</span>
</div>
<div>
<span class="fig">6<small>of 7</small></span>
<span class="sl">Bias checks passed, one disclosed</span>
</div>
</div>
<a class="btn btn-p" href="#case-study">Read case study</a>
</div>
</div>
</div>
</section>

<!-- 5. WORK -->
<section class="sec" id="work">
<div class="wrap">
<div class="work-top">
<div class="sec-h" style="margin-bottom:0">
<span class="eyebrow"><span class="gl" aria-hidden="true">β</span> &nbsp;Selected work · what drives the outcome</span>
<h2>Work</h2>
</div>
<div class="pills" role="group" aria-label="Choose work type">
<button class="pb on" type="button" data-tab="client" aria-pressed="true">Client Work</button>
<button class="pb" type="button" data-tab="course" aria-pressed="false">Coursework and Research</button>
</div>
</div>
{(['client','course'] as const).map((g) => (
<div class="cards2" data-group={g} hidden={g !== 'client'}>
{(g === 'client' ? client : course).map((p) => (
<article class="card proj">
<div class="ptop"><span class="eyebrow">{p.kind}</span><span class="chip chip-a">Synthetic</span></div>
<h3>{p.title}</h3>
<p>{p.summary}</p>
<div class="row">{p.tools.map((tool) => <span class="chip">{tool}</span>)}</div>
<div class="btns">
<a class="btn btn-p btn-s" href="#case-study">{p.action}</a>
<a class="btn btn-g btn-s" href="#github">GitHub</a>
</div>
</article>
))}
</div>
))}
</div>
</section>

<!-- 6. EXPERIENCE -->
<section class="sec" id="experience">
<div class="wrap">
<div class="work-top">
<div class="sec-h" style="margin-bottom:0">
<span class="eyebrow"><span class="gl" aria-hidden="true">Δ</span> &nbsp;Experience · change over time · placeholder entries</span>
<h2>Experience and education</h2>
</div>
<div class="pills" role="group" aria-label="Filter experience">
{['All', 'Analytics', 'Forecasting', 'Education'].map((f) => (
<button class={f === 'All' ? 'pb on' : 'pb'} type="button" data-filter={f} aria-pressed={f === 'All' ? 'true' : 'false'}>{f}</button>
))}
</div>
</div>
<div class="tl">
{entries.map((e) => (
<div class="tl-item" data-cats={e.cats.join(' ')}>
<div class="tl-l"><span class="tl-d">{e.dates}</span><span class="tl-o">{e.org}</span></div>
<div class="tl-r">
<h3>{e.role}</h3>
<ul><li>{e.b1}</li><li>{e.b2}</li></ul>
<div class="row">{e.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
</div>
</div>
))}
</div>
</div>
</section>

<!-- 7. CASE STUDY PREVIEW -->
<section class="sec" id="case-study">
<div class="wrap">
<div class="card csp">
<div class="csp-top">
<a class="btn btn-g btn-s" href="#work">← Back to all case studies</a>
<span class="chip chip-c">8 min read</span>
</div>
<span class="eyebrow">Case study preview · synthetic example</span>
<h2 style="margin-top:12px">Did an outreach program reduce missed appointments?</h2>
<div class="csp-grid">
<div class="cs-cards">
<div class="cs-c"><span class="eyebrow">Client</span><p>[Clinic network name], [N] clinics. Synthetic example.</p></div>
<div class="cs-c"><span class="eyebrow">Challenge</span><p>Staff believed the program worked, but visits were already falling for other reasons.</p></div>
<div class="cs-c"><span class="eyebrow"><span class="gl" aria-hidden="true">θ</span> &nbsp;Approach</span><p>Compared with similar clinics, then stress tested against six sources of bias.</p></div>
<div class="cs-c"><span class="eyebrow">Result</span><p>Missed visits fell about 5.6 points, a smaller effect than first claimed.</p></div>
</div>
<aside class="toc" aria-label="Contents">
<span class="eyebrow">Contents</span>
<ol>
<li class="on"><a href="#case-study"><span>01</span>Summary</a></li>
<li><a href="#case-study"><span>02</span>Context</a></li>
<li><a href="#case-study"><span>03</span>Data</a></li>
<li><a href="#case-study"><span>04</span>Method</a></li>
<li><a href="#case-study"><span>05</span>Bias checks</a></li>
<li><a href="#case-study"><span>06</span>Results</a></li>
<li><a href="#case-study"><span>07</span>What changed</a></li>
</ol>
</aside>
</div>
</div>
</div>
</section>

<!-- 8. ABOUT -->
<section class="sec" id="about">
<div class="wrap">
<div class="about-grid">
<div class="photo" role="img" aria-label="Photo placeholder"><span class="chip">Photo placeholder · 4:5</span></div>
<div>
<span class="eyebrow">About</span>
<h2>Curious, careful, open about what I do not know</h2>
<p>I am a data scientist who studies data in health, law and public policy. I believe data is power, and power needs care, so every analysis I do states its assumptions, tests for bias and shows its uncertainty.</p>
<p>[Short placeholder bio: background, the causes you care about, where you are based.]</p>
<div class="now">
<span class="eyebrow">Now</span>
<span><b>Currently:</b> writing a plain-language guide to checking an analysis for bias. [Placeholder]</span>
</div>
<a class="love" href="#love">Something I love: [a favourite book, trail or podcast] →</a>
</div>
</div>
</div>
</section>

<!-- 9. CLOSING CTA -->
<section id="contact">
<div class="wrap">
<div class="card closing">
<span class="eyebrow">Contact</span>
<h2>Have a question the data might answer?</h2>
<p>Tell me the change you want to support and the data you have. I will tell you if it can answer the question, and how I would check it for bias.</p>
<a class="btn btn-p" href="#book">Book a call</a>
<span class="sl"><span class="gl" aria-hidden="true">λ</span>Typical reply time: [N] working days. Placeholder.</span>
</div>

<footer class="foot">
<div class="foot-in">
<a class="brand" href="#top" aria-label="Back to top"><span class="mark" aria-hidden="true">Φ</span><span>Sana Anwer</span></a>
<div class="nav-r">
<a class="ib" href="#linkedin" aria-label="LinkedIn profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></a>
<a class="ib" href="#github" aria-label="GitHub profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg></a>
<a class="ib" href="#email" aria-label="Email Sana"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></a>
</div>
<small>© 2026 Sana Anwer. Placeholder content for design review.</small>
</div>
</footer>
</div>
</section>

</main>
</Base>
<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });

  const setPressed = (group: Element, active: Element) => {
    group.querySelectorAll('.pb').forEach((b) => {
      const on = b === active;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      setPressed(btn.parentElement!, btn);
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        g.hidden = g.dataset.group !== btn.dataset.tab;
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      setPressed(btn.parentElement!, btn);
      const f = btn.dataset.filter!;
      document.querySelectorAll<HTMLElement>('.tl-item').forEach((item) => {
        item.hidden = !(f === 'All' || (item.dataset.cats ?? '').split(' ').includes(f));
      });
    });
  });
</script>
