---
import Base from '../layouts/Base.astro';
import { client, course, entries } from '../data/content';
---
<Base>
<div class="barwrap">
<header class="bar">
<a class="brand" href="#top" aria-label="Sana Anwer, home">
<span class="mark" aria-hidden="true">Φ</span>
<span>Sana Anwer</span>
</a>
<nav class="nav-links" aria-label="Primary">
